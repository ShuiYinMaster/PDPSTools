            ("Via_001", "PmViaLocationOperation",  "150.0", "250.0", "350.0", "0", "45", "0", "待插入"),
            ("Gun_002", "PmWeldLocationOperation", "200.0", "300.0", "400.0", "30", "0", "0", "待插入"),
